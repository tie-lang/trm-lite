type tie<class>
// core/runtime/tl_runtime_ctx.tie —— trm-lite 复杂形态汇总库（p.6.5.1 外壳 / p.6.5.2 work-stealing）
// 复杂形态 = Go 式静态内置 runtime：用户 import 本库（相对路径指向 trm-lite
// 仓库）即选择复杂形态（import 即选择）；tiec 编译期拒绝与简单形态内置混用
//（spawn/yield/collect × 复杂形态汇总 → 明确报错）。
// 独立命名空间 tl_runtime_ctx：把复杂执行层（trm_lite_ws 调度 / trm_lite_tgc GC）
// 收敛为语言层入口 ctx_spawn/ctx_drain/ctx_collect，用户零配置使用。
// p.6.5.2：ctx_drain 升级为并行 run（work-stealing：多 OS 线程池 + 双端队列 +
// 任务窃取 + M:N）；ctx_set_workers/ctx_stolen/ctx_completed 供控制与验收。
// 后续切片同文件不拆 API、只换执行层实现（p.6.5.3 并发三色 / p.6.5.7 channel）。
import "../../core/mnn/sched_ws.tie"
import "../../core/gc/gc_tri.tie"

namespace tl_runtime_ctx {

pub func ctx_version() -> string {
    return "0.2.0"
}

// 复杂形态运行时惰性初始化（幂等）。
pub func ctx_ensure() {
    trm_lite_ws.ensure_state()
    trm_lite_tgc.ensure()
}

// 设置调度池大小（须在首个 drain 前设置；仅影响后续轮）。
pub func ctx_set_workers(m: i64) {
    trm_lite_ws.set_workers(m)
}
pub func ctx_workers() -> i64 {
    return trm_lite_ws.workers()
}

// 入队一个函数值执行体（含捕获闭包；任务内在再 spawn 安全）。返回任务序号。
pub func ctx_spawn(f: fn() -> i64) -> i64 {
    return trm_lite_ws.spawn(f)
}

// 未完成任务数（排队 + 运行中）。
pub func ctx_queued() -> i64 {
    return trm_lite_ws.queued_count()
}

// 并行 run（work-stealing）：起 P worker 并发执行全部就绪任务（含任务内
// 再 spawn 的子任务），全部完成后回收池。返回本轮执行任务数。
pub func ctx_drain() -> i64 {
    return trm_lite_ws.drain()
}

// 回收：本轮回收对象数（占位恒 0，p.6.5.3 并发三色接管）。
pub func ctx_collect() -> i64 {
    return trm_lite_tgc.collect()
}

// 观察量（验收断言）
pub func ctx_stolen() -> i64 {
    return trm_lite_ws.stolen_count()
}
pub func ctx_completed() -> i64 {
    return trm_lite_ws.completed_count()
}
// 进程收尾清理（探针退出前调用）
pub func ctx_shutdown() {
    trm_lite_ws.shutdown()
}
}