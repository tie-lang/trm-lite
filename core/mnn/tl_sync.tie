type tie<class>
// core/mnn/tl_sync.tie —— trm-lite 同步原语宿主（p.6.5.3 拆分）
// 命名空间封装函数（cs_*/cv_*/thr_*/sleep）单一声明源；kernel32 extern 声明
// 已抽至 tl_k32.tie（纯声明，p.6.7.6）——本文件 import 复用，自身不再声明。
// x64 ABI：缓冲区地址以 i64 传（alloc + ptr_to_int），void 桥按 i64 返回声明。
import "../../core/mnn/tl_k32.tie"

namespace tl_sync {

pub func cs_init(cs: i64) {
    unsafe {
        InitializeCriticalSection(cs);
    }
}
pub func cs_del(cs: i64) {
    unsafe {
        DeleteCriticalSection(cs);
    }
}
pub func cs_enter(cs: i64) {
    unsafe {
        EnterCriticalSection(cs);
    }
}
pub func cs_leave(cs: i64) {
    unsafe {
        LeaveCriticalSection(cs);
    }
}
pub func cv_init(cv: i64) {
    unsafe {
        InitializeConditionVariable(cv);
    }
}
pub func cv_wake(cv: i64) {
    unsafe {
        WakeConditionVariable(cv);
    }
}
pub func cv_wait(cv: i64, cs: i64, ms: i64) -> i64 {
    unsafe {
        return SleepConditionVariableCS(cv, cs, ms);
    }
}
pub func thr_create(sec: i64, stack: i64, start: string, arg: i64, flags: i64, tid: i64) -> i64 {
    unsafe {
        return CreateThread(sec, stack, start, arg, flags, tid);
    }
}
pub func thr_wait(h: i64, ms: i64) -> i64 {
    unsafe {
        return WaitForSingleObject(h, ms);
    }
}
pub func thr_close(h: i64) -> i64 {
    unsafe {
        return CloseHandle(h);
    }
}
pub func sleep(ms: i64) {
    unsafe {
        Sleep(ms);
    }
}
}