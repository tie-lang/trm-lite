type tie<class>
// core/mnn/sched_ws.tie —— trm-lite 复杂形态 work-stealing 调度器（p.6.5.2 多线程 / p.6.5.3 并入后台回收器 / p.6.5.5 可迁移栈 / p.6.7.8 常驻池 / p.6.7.9 per-P 细锁）
// 多 OS 线程池 + 每线程双端队列 + 任务窃取 + M:N 承托 + **并发三色 GC 后台回收器**：
//   · 任务承载 = 注册表 g_regs（table<fn() -> i64>）+ 队列元素 regid（table<i64>）
//   · 每线程双端队列 = g_items 预分配 P×SEG_CAP 槽（段固定不重叠）；owner 段尾
//     LIFO 自取，他人段头 FIFO 窃取，段满溢出全局 g_ovf（p.6.5.2 定稿）
//   · **可迁移栈（p.6.5.5）**：tie 任务为 fn() 原子执行体，「可迁移」= 任务与创建
//     worker 解耦，任意 worker 皆可执行：g_exec_w 登记执行者；g_migrated 计数
//     （worker≠创建者即迁移）；sweep 仅发生「pending==0 && active==0」窗口（任务
//     运行期分配/存活对象受保护——GC 根 = 当前运行任务 env）
//   · **p.6.7.9 per-P 细锁（去全局单 CS）**：每 worker 段独立 CS（g_seg_lks[i]，
//     自取/窃取只锁目标段）、全局溢出队列独立锁 g_ovf_lk、计数+空判断+唤醒收敛
//     短临界计数锁 g_cnt_lk（不做任何任务数据操作）、寄存器表追加锁 g_regs_lk。
//     全程**单锁持有**（无嵌套多锁 → 无死锁）；窃取窗口缩小到目标段。锁序纪律：
//     任意路径同时只持一把锁，跨锁操作逐把入/出。
//   · 池常驻（p.6.7.8）：起于首次 drain、止于 shutdown；worker/GC 空闲 cv_wait
//     存活，见 g_shutdown==1 退出。
//   · 终止协议（p.6.5.2）：worker 仅当全部完成退出；pending/active 同锁原子视图。
//   · 同步 primitives 单一声明源 tl_k32（经 tl_sync 命名空间封装）。
import "../../core/mnn/tl_sync.tie"
import "../../core/gc/gc_tri.tie"

const WS_SEG_CAP: i64 = 256   // 每 worker deque 段容量（task 槽）

var g_workers: i64 = 4        // 池大小 P（set_workers 在首个 drain 前设置生效）
var g_cv: i64 = 0             // 条件变量缓冲地址（配 g_cnt_lk）
var g_state_init: i64 = 0

// p.6.7.9 细锁集合
var g_cnt_lk: i64 = 0         // 计数/状态锁（pending/active/done/migrated/spi + 空判断 + CV 等待）
var g_regs_lk: i64 = 0        // 寄存器表追加锁（g_regs/g_orig_w/g_exec_w append）
var g_ovf_lk: i64 = 0         // 全局溢出队列细锁
var g_seg_lks: table<i64> = []  // 每 worker 段 CS 缓冲地址（per-P 细锁）

var g_regs: table<fn() -> i64> = []   // 任务注册表（regid = 下标；跨轮存活）
var g_orig_w: table<i64> = []         // 每任务创建 worker（p.6.5.5 迁移判定）
var g_exec_w: table<i64> = []         // 每任务执行 worker（p.6.5.5 可迁移登记）
var g_items: table<i64> = []          // 每 worker deque 段（P×SEG_CAP 预分配）
var g_h: table<i64> = []
var g_t: table<i64> = []
var g_ovf: table<i64> = []
var g_ovf_head: i64 = 0
var g_spi: i64 = 0

var g_pending: i64 = 0
var g_active: i64 = 0
var g_done: i64 = 0
var g_stolen: i64 = 0
var g_migrated: i64 = 0               // 迁移计数（p.6.5.5：worker≠创建者的执行次数）
var g_ths: table<i64> = []            // worker 线程句柄表
var g_gc_th: i64 = 0                  // 后台回收器线程句柄
var g_pool_up: i64 = 0                // 池常驻标记（p.6.7.8：起于首次 drain、止于 shutdown）
var g_shutdown: i64 = 0               // 停机标记（p.6.7.8：worker/GC 见 1 退出，池销毁）

namespace trm_lite_ws {

// ---------- 细锁封装（p.6.7.9；单锁持有纪律，杜绝多锁嵌套） ----------
func cnt_enter() {
    unsafe {
        tl_sync.cs_enter(g_cnt_lk)
    }
}
func cnt_leave() {
    unsafe {
        tl_sync.cs_leave(g_cnt_lk)
    }
}
func regs_enter() {
    unsafe {
        tl_sync.cs_enter(g_regs_lk)
    }
}
func regs_leave() {
    unsafe {
        tl_sync.cs_leave(g_regs_lk)
    }
}
func ovf_enter() {
    unsafe {
        tl_sync.cs_enter(g_ovf_lk)
    }
}
func ovf_leave() {
    unsafe {
        tl_sync.cs_leave(g_ovf_lk)
    }
}
func seg_enter(i: i64) {
    unsafe {
        tl_sync.cs_enter(g_seg_lks[i])
    }
}
func seg_leave(i: i64) {
    unsafe {
        tl_sync.cs_leave(g_seg_lks[i])
    }
}

// 一次初始化（幂等）：建细锁集（P 段锁 + 溢出/计数/寄存器锁 + CV）+ 段表。
pub func ensure_state() {
    // 标量全局初值在 tie 中被静默丢弃（`= 4` 实际 0）——强制默认池大小。
    if g_workers < 1 {
        g_workers = 4
    }
    if g_state_init == 0 {
        unsafe {
            g_cnt_lk = ptr_to_int(alloc(64))
            g_regs_lk = ptr_to_int(alloc(64))
            g_ovf_lk = ptr_to_int(alloc(64))
            g_cv = ptr_to_int(alloc(64))
            tl_sync.cs_init(g_cnt_lk)
            tl_sync.cs_init(g_regs_lk)
            tl_sync.cs_init(g_ovf_lk)
            tl_sync.cv_init(g_cv)
        }
        g_seg_lks = table_new_i64()
        g_h = table_new_i64()
        g_t = table_new_i64()
        g_ths = table_new_i64()
        var i: i64 = 0
        while i < g_workers {
            var lk: i64 = 0
            unsafe {
                lk = ptr_to_int(alloc(64))
                tl_sync.cs_init(lk)
            }
            table_push(g_seg_lks, lk)
            table_push(g_h, 0)
            table_push(g_t, 0)
            i = i + 1
        }
        var cap = g_workers * WS_SEG_CAP
        var it: table<i64> = table_new_i64()
        i = 0
        while i < cap {
            table_push(it, 0)
            i = i + 1
        }
        g_items = it
        g_ovf = table_new_i64()
        trm_lite_tgc.ensure()   // GC 内核就绪（后台回收器依赖）
        g_state_init = 1
    }
}

// 池大小（须在首个 drain 前设置；改 P 会重建段表 + 段锁）。
pub func set_workers(m: i64) {
    // p.6.7.8：池已常驻后禁止改 P（段表重建与实际线程数失配）。
    if m < 1 || m == g_workers || g_pool_up == 1 {
        return
    }
    g_workers = m
    if g_state_init == 1 {
        cnt_enter()
        // 重建段锁（旧锁销毁；无并发窗口——首个 drain 前）
        var i: i64 = 0
        while i < len(g_seg_lks) {
            unsafe {
                tl_sync.cs_del(g_seg_lks[i])
            }
            i = i + 1
        }
        var lk: table<i64> = table_new_i64()
        var hi: table<i64> = table_new_i64()
        var ti: table<i64> = table_new_i64()
        i = 0
        while i < g_workers {
            var cs: i64 = 0
            unsafe {
                cs = ptr_to_int(alloc(64))
                tl_sync.cs_init(cs)
            }
            table_push(lk, cs)
            table_push(hi, 0)
            table_push(ti, 0)
            i = i + 1
        }
        g_seg_lks = lk
        g_h = hi
        g_t = ti
        var cap = g_workers * WS_SEG_CAP
        var it: table<i64> = table_new_i64()
        i = 0
        while i < cap {
            table_push(it, 0)
            i = i + 1
        }
        g_items = it
        var of: table<i64> = table_new_i64()
        g_ovf = of
        g_ovf_head = 0
        g_spi = 0
        g_pending = 0
        g_active = 0
        cnt_leave()
    }
}
pub func workers() -> i64 {
    return g_workers
}
// 计数锁地址（tl_runtime_ctx 汇总层可按需复用；当前 GC 用自有锁）。
// p.6.7.9：原全局单 CS 已拆细锁——对外暴露短临界计数锁（最接近原语义的宿主）。
pub func sync_cs() -> i64 {
    return g_cnt_lk
}

// 入队函数值执行体（含捕获闭包）：p.6.7.9 细锁分步——计数锁取轮转位 →
// 寄存器锁追加 → 段锁写段（满则溢出锁转溢出表）→ 计数锁 pending++ + 唤醒。
// 每步一把短锁，杜绝多锁嵌套。任务内再 spawn 亦安全。
pub func spawn(f: fn() -> i64) -> i64 {
    ensure_state()
    var w: i64 = 0
    cnt_enter()
    w = g_spi % g_workers
    g_spi = g_spi + 1
    cnt_leave()
    var regid: i64 = 0
    regs_enter()
    regid = len(g_regs)
    table_push(g_regs, f)
    table_push(g_orig_w, w)         // 创建 worker（p.6.5.5 迁移判定基准）
    table_push(g_exec_w, -1)        // 执行 worker 未定
    regs_leave()
    var to_ovf: i64 = 0
    seg_enter(w)
    if g_t[w] < WS_SEG_CAP {
        g_items[w * WS_SEG_CAP + g_t[w]] = regid
        g_t[w] = g_t[w] + 1
    } else {
        to_ovf = 1
    }
    seg_leave(w)
    if to_ovf == 1 {
        ovf_enter()
        table_push(g_ovf, regid)
        ovf_leave()
    }
    cnt_enter()
    g_pending = g_pending + 1
    tl_sync.cv_wake(g_cv)
    cnt_leave()
    return regid
}

// 未完成任务数（排队 + 运行中）。
pub func queued_count() -> i64 {
    ensure_state()
    cnt_enter()
    var p = g_pending
    cnt_leave()
    return p
}

// worker 主循环：p.6.7.9 细锁——自己段尾 LIFO（锁自段）→ 窃取他人段头 FIFO
// （逐目标段短锁）→ 全局溢出队头（溢出锁）→ 计账（计数锁）→ 执行 → done（计数锁）
// → 空闲 cv_wait（计数锁）。常驻（p.6.7.8）：仅 g_shutdown==1 退出。
func worker_main(arg: i64) -> i64 {
    var me = arg
    var last: i64 = 0
    while 1 {
        var got: i64 = 0
        var regid: i64 = 0
        // ① 自段尾 LIFO（锁自段）
        seg_enter(me)
        if g_t[me] > g_h[me] {
            var pos = g_t[me] - 1
            regid = g_items[me * WS_SEG_CAP + pos]
            g_t[me] = pos
            got = 1
        }
        seg_leave(me)
        // ② 窃取他人段头 FIFO（逐目标段短锁，拿/放完即解锁）
        var r: i64 = 1
        while got == 0 && r < g_workers {
            var j = (me + r) % g_workers
            seg_enter(j)
            if g_t[j] > g_h[j] {
                regid = g_items[j * WS_SEG_CAP + g_h[j]]
                g_h[j] = g_h[j] + 1
                g_stolen = g_stolen + 1
                got = 1
            }
            seg_leave(j)
            r = r + 1
        }
        // ③ 全局溢出队头（溢出锁）
        if got == 0 {
            ovf_enter()
            if g_ovf_head < len(g_ovf) {
                regid = g_ovf[g_ovf_head]
                g_ovf_head = g_ovf_head + 1
                g_stolen = g_stolen + 1
                got = 1
            }
            ovf_leave()
        }
        // 计账（计数锁）：活跃++、执行 worker 登记、迁移计数
        if got == 1 {
            cnt_enter()
            g_active = g_active + 1
            g_exec_w[regid] = me
            if g_orig_w[regid] != me {
                g_migrated = g_migrated + 1
            }
            cnt_leave()
        }
        if got == 1 {
            last = g_regs[regid]()   // 寄存器行只追加不改写，无锁读安全
            cnt_enter()
            g_active = g_active - 1
            g_pending = g_pending - 1
            g_done = g_done + 1
            cnt_leave()
        } else {
            cnt_enter()
            if g_shutdown == 1 {
                cnt_leave()
                return last
            }
            // 空闲：限时等待（新任务 spawn 经 cv_wake 唤醒；醒来循环顶重查）
            var w = tl_sync.cv_wait(g_cv, g_cnt_lk, 50)
            cnt_leave()
        }
    }
}

// 后台回收器主循环（p.6.5.3）：与 worker 真并发推进三色标记；只有「无任务运行」
// 窗口才做大批次，sweep 安全。p.6.7.8：常驻——仅 g_shutdown==1 时退出。
func gc_worker_main(_: i64) -> i64 {
    var last: i64 = 0
    while 1 {
        var idle: i64 = 0
        cnt_enter()
        if g_shutdown == 1 {
            cnt_leave()
            return last
        }
        if g_pending == 0 && g_active == 0 {
            idle = 1
        }
        cnt_leave()
        var batch: i64 = 64
        if idle == 1 {
            batch = 2000000
        }
        var fin = trm_lite_tgc.bg_step(batch, idle)
        tl_sync.sleep(1)
    }
}

// 起池（p.6.7.8）：**常驻**——仅首次 drain 创建 P worker + 1 后台回收器。
func ensure_pool() {
    if g_pool_up == 1 {
        return
    }
    g_pool_up = 1
    g_shutdown = 0
    var i: i64 = 0
    while i < g_workers {
        var th: i64 = 0
        th = tl_sync.thr_create(0, 0, cb_ptr(worker_main), i, 0, 0)
        table_push(g_ths, th)
        i = i + 1
    }
    g_gc_th = tl_sync.thr_create(0, 0, cb_ptr(gc_worker_main), 0, 0, 0)
}

// 池销毁（仅 shutdown 路径）：join 全部 worker + 后台回收器（见 g_shutdown=1 退出）。
func join_pool() {
    var i: i64 = 0
    while i < len(g_ths) {
        tl_sync.thr_wait(g_ths[i], 10000)
        tl_sync.thr_close(g_ths[i])
        i = i + 1
    }
    if g_gc_th != 0 {
        tl_sync.thr_wait(g_gc_th, 10000)
        tl_sync.thr_close(g_gc_th)
        g_gc_th = 0
    }
    var nth = table_new_i64()
    g_ths = nth
    g_pool_up = 0
}

// 本轮状态复位（drain 收尾：pending==0 无并发窗口，主线程独占；p.6.7.9 逐细锁清）。
// g_done/g_stolen 跨轮累计（drain 返回本轮增量，观察量取累计）。
// p.6.7.8：**不再清 g_ths**（线程句柄表是池资产，只随 join_pool 销毁）。
func reset_round() {
    var i: i64 = 0
    while i < len(g_h) {
        seg_enter(i)
        g_h[i] = 0
        g_t[i] = 0
        seg_leave(i)
        i = i + 1
    }
    ovf_enter()
    g_ovf = table_new_i64()
    g_ovf_head = 0
    ovf_leave()
    cnt_enter()
    g_spi = 0
    g_pending = 0
    g_active = 0
    cnt_leave()
}

// 并行 run：P worker 并发执行全部任务（含任务内再 spawn）+ 后台回收器并发
// 三色标记。p.6.7.8：等待本轮排空后**不做池回收**（池常驻）。返回本轮任务数（增量）。
pub func drain() -> i64 {
    ensure_state()
    var base: i64 = 0
    cnt_enter()
    base = g_done
    cnt_leave()
    ensure_pool()
    cnt_enter()
    while g_pending > 0 {
        var w = tl_sync.cv_wait(g_cv, g_cnt_lk, 50)
    }
    var r = g_done - base
    cnt_leave()
    reset_round()
    return r
}

// 常驻池线程句柄表长度（p.6.7.8 观察量：多轮 drain 不增长）。
pub func thread_count() -> i64 {
    return len(g_ths)
}

// 观察量（跨轮累计；探针在 drain 后单线程读取，细锁保证一致性）
pub func completed_count() -> i64 {
    cnt_enter()
    var d = g_done
    cnt_leave()
    return d
}
pub func stolen_count() -> i64 {
    cnt_enter()
    var s = g_stolen
    cnt_leave()
    return s
}
// 迁移计数（p.6.5.5：worker≠创建者的执行次数，跨轮累计）
pub func migrated_count() -> i64 {
    cnt_enter()
    var m = g_migrated
    cnt_leave()
    return m
}
// 任务执行 worker 分布：统计每 worker 实际执行了多少任务（跨轮累计核验
// 「任务任意 worker 执行」，无需线程内自标记）。
pub func exec_worker(id: i64) -> i64 {
    if id < 0 || id >= len(g_exec_w) {
        return -1
    }
    return g_exec_w[id]
}
// 运行时全局清理（进程收尾）。p.6.7.8/6.7.9：真正池销毁——置停机标记 + 广播唤醒
// （worker/GC 见 1 退出）→ join 全部线程 → 销毁全部细锁（段锁/溢出/计数/寄存器/CV）。
// 幂等。
pub func shutdown() {
    if g_state_init == 1 {
        if g_pool_up == 1 {
            cnt_enter()
            g_shutdown = 1
            tl_sync.cv_wake(g_cv)
            cnt_leave()
            join_pool()
        }
        unsafe {
            tl_sync.cs_del(g_cnt_lk)
            tl_sync.cs_del(g_regs_lk)
            tl_sync.cs_del(g_ovf_lk)
        }
        // CONDITION_VARIABLE 无销毁语义（纯结构），无须删除
        var i: i64 = 0
        while i < len(g_seg_lks) {
            unsafe {
                tl_sync.cs_del(g_seg_lks[i])
            }
            i = i + 1
        }
        g_cnt_lk = 0
        g_regs_lk = 0
        g_ovf_lk = 0
        g_cv = 0
        g_seg_lks = table_new_i64()
        g_state_init = 0
    }
}
}