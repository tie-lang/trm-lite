type tie<class>
// core/mnn/sched_ws.tie —— trm-lite 复杂形态 work-stealing 调度器（p.6.5.2 多线程 / p.6.5.3 并入后台回收器 / p.6.5.5 可迁移栈）
// 多 OS 线程池 + 每线程双端队列 + 任务窃取 + M:N 承托 + **并发三色 GC 后台回收器**：
//   · 任务承载 = 注册表 g_regs（table<fn() -> i64>）+ 队列元素 regid（table<i64>）
//   · 每线程双端队列 = g_items 预分配 P×SEG_CAP 槽（段固定不重叠）；owner 段尾
//     LIFO 自取，他人段头 FIFO 窃取，段满溢出全局 g_ovf（p.6.5.2 定稿）
//   · **可迁移栈（p.6.5.5）**：tie 任务为 fn() 原子执行体（无 OS 级协程栈迁移），
//     「可迁移」语义落位为——任务与创建 worker 解耦，任意 worker 皆可执行：
//       1) 任务执行 worker 登记 g_exec_w（spawn 时记创建者 g_orig_w）
//       2) 迁移计数 g_migrated：worker ≠ 创建者 的执行（窃取/溢出取走）即迁移
//       3) 运行中任务根保护：sweep 仅发生在「pending==0 && active==0」窗口，
//          任务运行期间分配/存活对象天然受保护（GC 根 = 当前运行任务 env，
//          降级保守根精度损失见设计 §6/§9）
//   · 线程池按轮创建/回收（worker×P + GC×1）；同步 primitives 悉数经 tl_sync 宿主
//     （tie extern 声明按文件作用域且跨文件不可重名——单一声明源）
//   · 后台回收器：GC 线程与 worker 真并发推进三色标记（trm_lite_tgc.bg_step）；
//     收敛发生在「无可取 && pending==0 && active==0」窗口（无写屏障 ⇒ sweep 安全）
//   · 终止协议（p.6.5.2）：worker 仅当全部完成退出；pending/active 同锁原子视图
//   · 抢占：任务为 fn() 原子执行体不可中断；时间片硬抢占待语言级中断支持
import "../../core/mnn/tl_sync.tie"
import "../../core/gc/gc_tri.tie"

const WS_SEG_CAP: i64 = 256   // 每 worker deque 段容量（task 槽）

var g_workers: i64 = 4        // 池大小 P（set_workers 在首个 drain 前设置生效）
var g_cs: i64 = 0             // 全局 CRITICAL_SECTION 缓冲地址（调度锁，tl_sync 操作）
var g_cv: i64 = 0             // 全局 CONDITION_VARIABLE 缓冲地址
var g_state_init: i64 = 0

var g_regs: table<fn() -> i64> = []   // 任务注册表（regid = 下标；跨轮存活）
var g_orig_w: table<i64> = []         // 每任务创建 worker（p.6.5.5 迁移判定）
var g_exec_w: table<i64> = []         // 每任务执行 worker（p.6.5.5 可迁移登记）
var g_items: table<i64> = []          // 每 worker deque 段（P×SEG_CAP 预分配）
var g_h: table<i64> = []
var g_t: table<i64> = []
var g_ovf: table<i64> = []
var g_ovf_head: i64 = 0
var g_spi: i64 = 0

var g_pending: i64 = 0
var g_active: i64 = 0
var g_done: i64 = 0
var g_stolen: i64 = 0
var g_migrated: i64 = 0               // 迁移计数（p.6.5.5：worker≠创建者的执行次数）
var g_ths: table<i64> = []            // worker 线程句柄表
var g_gc_th: i64 = 0                  // 后台回收器线程句柄
var g_pool_up: i64 = 0                // 池常驻标记（p.6.7.8：起于首次 drain、止于 shutdown）
var g_shutdown: i64 = 0               // 停机标记（p.6.7.8：worker/GC 见 1 退出，池销毁）

namespace trm_lite_ws {

// 一次初始化（幂等）。
pub func ensure_state() {
    // 标量全局初值在 tie 中被静默丢弃（`= 4` 实际 0）——强制默认池大小。
    if g_workers < 1 {
        g_workers = 4
    }
    if g_state_init == 0 {
        unsafe {
            g_cs = ptr_to_int(alloc(64))
            g_cv = ptr_to_int(alloc(64))
            tl_sync.cs_init(g_cs)
            tl_sync.cv_init(g_cv)
        }
        g_h = table_new_i64()
        g_t = table_new_i64()
        g_ths = table_new_i64()
        var i: i64 = 0
        while i < g_workers {
            table_push(g_h, 0)
            table_push(g_t, 0)
            i = i + 1
        }
        var cap = g_workers * WS_SEG_CAP
        var it: table<i64> = table_new_i64()
        i = 0
        while i < cap {
            table_push(it, 0)
            i = i + 1
        }
        g_items = it
        g_ovf = table_new_i64()
        trm_lite_tgc.ensure()   // GC 内核就绪（后台回收器依赖）
        g_state_init = 1
    }
}

// 池大小（须在首个 drain 前设置；改 P 会重建段表）。
pub func set_workers(m: i64) {
    // p.6.7.8：池已常驻后禁止改 P（段表重建与实际线程数失配）。
    if m < 1 || m == g_workers || g_pool_up == 1 {
        return
    }
    g_workers = m
    if g_state_init == 1 {
        tl_sync.cs_enter(g_cs)
        var hi: table<i64> = table_new_i64()
        var ti: table<i64> = table_new_i64()
        var i: i64 = 0
        while i < g_workers {
            table_push(hi, 0)
            table_push(ti, 0)
            i = i + 1
        }
        g_h = hi
        g_t = ti
        var cap = g_workers * WS_SEG_CAP
        var it: table<i64> = table_new_i64()
        i = 0
        while i < cap {
            table_push(it, 0)
            i = i + 1
        }
        g_items = it
        var of: table<i64> = table_new_i64()
        g_ovf = of
        g_ovf_head = 0
        g_spi = 0
        g_pending = 0
        g_active = 0
        tl_sync.cs_leave(g_cs)
    }
}
pub func workers() -> i64 {
    return g_workers
}
// 调度锁地址（tl_runtime_ctx 汇总层可按需复用；当前 GC 用自有锁）。
pub func sync_cs() -> i64 {
    return g_cs
}

// 入队函数值执行体（含捕获闭包）：注册 → 轮转推段（满则溢出）。返回任务 id。
// 任务内再 spawn 亦安全（全程持调度锁）。
pub func spawn(f: fn() -> i64) -> i64 {
    ensure_state()
    tl_sync.cs_enter(g_cs)
    var regid: i64 = len(g_regs)
    table_push(g_regs, f)
    var w = g_spi % g_workers
    table_push(g_orig_w, w)         // 创建 worker（p.6.5.5 迁移判定基准）
    table_push(g_exec_w, -1)        // 执行 worker 未定
    if g_t[w] < WS_SEG_CAP {
        g_items[w * WS_SEG_CAP + g_t[w]] = regid
        g_t[w] = g_t[w] + 1
    } else {
        table_push(g_ovf, regid)
    }
    g_spi = g_spi + 1
    g_pending = g_pending + 1
    tl_sync.cv_wake(g_cv)
    tl_sync.cs_leave(g_cs)
    return len(g_regs) - 1
}

// 未完成任务数（排队 + 运行中）。
pub func queued_count() -> i64 {
    ensure_state()
    tl_sync.cs_enter(g_cs)
    var p = g_pending
    tl_sync.cs_leave(g_cs)
    return p
}

// worker 主循环：自己段尾 LIFO → 窃取他人段头 FIFO → 全局溢出队头 → 闲置等待。
// p.6.7.8：常驻池——「无可取 && pending==0 && active==0」**不再退出**，改 cv_wait
// 限时继续存活（新一轮 spawn 经 cv_wake 唤醒）；仅 g_shutdown==1 时退出（池销毁）。
func worker_main(arg: i64) -> i64 {
    var me = arg
    var last: i64 = 0
    while 1 {
        var got: i64 = 0
        var regid: i64 = 0
        tl_sync.cs_enter(g_cs)
        if g_t[me] > g_h[me] {
            var pos = g_t[me] - 1
            regid = g_items[me * WS_SEG_CAP + pos]
            g_t[me] = pos
            got = 1
        }
        var r: i64 = 1
        while got == 0 && r < g_workers {
            var j = (me + r) % g_workers
            if g_t[j] > g_h[j] {
                regid = g_items[j * WS_SEG_CAP + g_h[j]]
                g_h[j] = g_h[j] + 1
                g_stolen = g_stolen + 1
                got = 1
            }
            r = r + 1
        }
        while got == 0 && g_ovf_head < len(g_ovf) {
            regid = g_ovf[g_ovf_head]
            g_ovf_head = g_ovf_head + 1
            g_stolen = g_stolen + 1
            got = 1
        }
        if got == 1 {
            g_active = g_active + 1
            // p.6.5.5 可迁移栈：登记执行 worker；worker≠创建者 → 迁移计数。
            // 自取/窃取/溢出在此统一收敛（got 时即已决定取自何处）。
            g_exec_w[regid] = me
            if g_orig_w[regid] != me {
                g_migrated = g_migrated + 1
            }
        }
        tl_sync.cs_leave(g_cs)
        if got == 1 {
            last = g_regs[regid]()
            tl_sync.cs_enter(g_cs)
            g_active = g_active - 1
            g_pending = g_pending - 1
            g_done = g_done + 1
            tl_sync.cs_leave(g_cs)
        } else {
            tl_sync.cs_enter(g_cs)
            if g_shutdown == 1 {
                tl_sync.cs_leave(g_cs)
                return last
            }
            // 空闲：限时等待（新任务 spawn 唤醒；短路判断在醒来后于循环顶重来）
            var w = tl_sync.cv_wait(g_cv, g_cs, 50)
            tl_sync.cs_leave(g_cs)
        }
    }
}

// 后台回收器主循环（p.6.5.3）：与 worker 真并发推进三色标记；只有「无任务运行」
// 窗口才做大批次，sweep 安全。p.6.7.8：常驻——一直在后台跑（含跨 drain 空闲
// 窗口），仅 g_shutdown==1 时退出（池销毁 join）。
func gc_worker_main(_: i64) -> i64 {
    var last: i64 = 0
    while 1 {
        var idle: i64 = 0
        tl_sync.cs_enter(g_cs)
        if g_shutdown == 1 {
            tl_sync.cs_leave(g_cs)
            return last
        }
        if g_pending == 0 && g_active == 0 {
            idle = 1
        }
        tl_sync.cs_leave(g_cs)
        var batch: i64 = 64
        if idle == 1 {
            batch = 2000000
        }
        var fin = trm_lite_tgc.bg_step(batch, idle)
        tl_sync.sleep(1)
    }
}

// 起池（p.6.7.8）：**常驻**——仅首次 drain 创建 P worker + 1 后台回收器；
// 之后 ensure_pool 幂等直通（不再每轮重建/回收）。
func ensure_pool() {
    if g_pool_up == 1 {
        return
    }
    g_pool_up = 1
    g_shutdown = 0
    var i: i64 = 0
    while i < g_workers {
        var th: i64 = 0
        th = tl_sync.thr_create(0, 0, cb_ptr(worker_main), i, 0, 0)
        table_push(g_ths, th)
        i = i + 1
    }
    g_gc_th = tl_sync.thr_create(0, 0, cb_ptr(gc_worker_main), 0, 0, 0)
}

// 池销毁（仅 shutdown 路径）：join 全部 worker + 后台回收器（见 g_shutdown=1 退出）。
func join_pool() {
    var i: i64 = 0
    while i < len(g_ths) {
        tl_sync.thr_wait(g_ths[i], 10000)
        tl_sync.thr_close(g_ths[i])
        i = i + 1
    }
    if g_gc_th != 0 {
        tl_sync.thr_wait(g_gc_th, 10000)
        tl_sync.thr_close(g_gc_th)
        g_gc_th = 0
    }
    var nth = table_new_i64()
    g_ths = nth
    g_pool_up = 0
}

// 本轮状态复位（drain 收尾：无并发窗口，主线程独占）。
// g_done/g_stolen 跨轮累计（drain 返回本轮增量，观察量取累计）。
// p.6.7.8：**不再清 g_ths**（线程句柄表是池资产，只随 join_pool 销毁）。
func reset_round() {
    g_spi = 0
    g_pending = 0
    g_active = 0
    var i: i64 = 0
    while i < len(g_h) {
        g_h[i] = 0
        g_t[i] = 0
        i = i + 1
    }
    var of: table<i64> = table_new_i64()
    g_ovf = of
    g_ovf_head = 0
}

// 并行 run：P worker 并发执行全部任务（含任务内再 spawn）+ 后台回收器并发
// 三色标记。p.6.7.8：等待本轮排空后**不做池回收**（池常驻）；句柄表恒定。
// 返回本轮执行任务数（增量）。
pub func drain() -> i64 {
    ensure_state()
    var base = g_done
    ensure_pool()
    tl_sync.cs_enter(g_cs)
    while g_pending > 0 {
        var w = tl_sync.cv_wait(g_cv, g_cs, 50)
    }
    tl_sync.cs_leave(g_cs)
    var r = g_done - base
    reset_round()
    return r
}

// 常驻池线程句柄表长度（p.6.7.8 观察量：多轮 drain 不增长）。
pub func thread_count() -> i64 {
    return len(g_ths)
}

// 观察量（跨轮累计）
pub func completed_count() -> i64 {
    tl_sync.cs_enter(g_cs)
    var d = g_done
    tl_sync.cs_leave(g_cs)
    return d
}
pub func stolen_count() -> i64 {
    tl_sync.cs_enter(g_cs)
    var s = g_stolen
    tl_sync.cs_leave(g_cs)
    return s
}
// 迁移计数（p.6.5.5：worker≠创建者的执行次数，跨轮累计）
pub func migrated_count() -> i64 {
    tl_sync.cs_enter(g_cs)
    var m = g_migrated
    tl_sync.cs_leave(g_cs)
    return m
}
// 任务执行 worker 分布：统计每 worker 实际执行了多少任务（跨轮累计核验
// 「任务任意 worker 执行」，无需线程内自标记）。
pub func exec_worker(id: i64) -> i64 {
    if id < 0 || id >= len(g_exec_w) {
        return -1
    }
    return g_exec_w[id]
}
// 运行时全局清理（进程收尾）。p.6.7.8：真正池销毁——置停机标记 + 广播唤醒
// （worker/GC 见 1 退出）→ join 全部线程 → 删段/锁。幂等。
pub func shutdown() {
    if g_state_init == 1 {
        if g_pool_up == 1 {
            tl_sync.cs_enter(g_cs)
            g_shutdown = 1
            tl_sync.cv_wake(g_cv)
            tl_sync.cs_leave(g_cs)
            join_pool()
        }
        tl_sync.cs_del(g_cs)
        g_state_init = 0
    }
}
}