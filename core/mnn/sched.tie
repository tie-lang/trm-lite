type tie<class>
// core/mnn/sched.tie —— trm-lite 简单形态执行内核（命名空间 trm_lite_sched，p.6.7.6）。
// 阶段1的「协作式 M:N step 调度内核」（tick/run_all 轻量执行体）已被 p.6.7.6 的
// S-pool 常驻线程池取代：简单形态真并行 = 内置 spawn 入队 → 常驻 worker 线程
// 并行抢执行，yield = 同步点。本文件只保留 S-pool 线程安全队列 + 同步 + 任务
// 入队/摘取（全部经 tl_k32 单一声明源，p.6.7.6）。
import "../../core/mnn/tl_k32.tie"

const TRM_LITE_SCHED_VERSION: string = "0.1.0"

// ---------- 闭包任务队列（spawn/yield 内置的运行时载体） ----------
// 每个任务 = 一个「轻量执行体」：{entry, env, retcode}（entry/env 为闭包聚合的
// 入口/环境指针，i64 承载；retcode = 返回形态编码，0=i64 / 1=void）。
// 由 tiec 内置 codegen 以 extern 符号调用本组函数；tie 源码侧扁平表存储。
var g_tq_entry: table<i64>;           // 任务入口指针（entry）
var g_tq_env: table<i64>;             // 任务环境指针（env）
var g_tq_retcode: table<i64>;         // 任务返回形态编码
var g_worker: i64 = 2                 // S-pool 池大小 M（set_workers/pool_workers）

// 任务返回形态编码（与 tiec builtin_expr 的 drain 分派对齐）：
// retcode 0=i64 / 1=void，由编译器 codegen 以字面量传递（tig_s_pool_worker
// rcv==0 分派）；此处不设 const 全局——文件级 const 会以全局符号进 trm_lite.a
// 的 tl_runtime.o 成员，直接 import 本文件的程序与之重复定义（LNK2005，p.6.7.2
// 双成员 .a 结构后暴露）。契约以注释固化，不在运行库内留可导出符号。

// ---------- p.6.7.6 S-pool：简单形态常驻线程池 ----------
// 简单形态由「yield 手动驱动单线程排空」升级为**真并行**：
//   · tiec 内置 spawn 入队后调 pool_try_start（闸）→ 程序侧发射的常驻 worker
//     线程（tie_s_pool_worker，CreateThread 由编译器生成）并行抢任务执行；
//   · 本文件只负责**线程安全队列 + 同步**（入队/抢任务/完成计数/同步点）：
//     spawn_task（锁内 push + pend++ + 唤醒）、pop_task（锁内原子摘头 +
//     out 槽写回）、task_done（pend-- + 空时广播）、yield_wait（同步点：
//     等 pend==0，任务全跑完——对旧程序与「排空」观察等价）、
//     pool_idle_wait（worker 空队限时等待防忙轮询）。
//   · 池常驻：线程建起后不随 drain 终止（进程退出由 OS 回收）；
//     yield 之后的再 spawn 直接复用既有线程（gate=1 不再重建）。

// S-pool 同步状态：调度锁/条件变量缓冲地址、启动闸、未完成计数。
var g_pool_ready: i64 = 0   // CS/CV 缓冲已初始化（惰性）
var g_cs_s: i64 = 0         // 队列 CRITICAL_SECTION 缓冲地址
var g_cv_s: i64 = 0         // 队列 CONDITION_VARIABLE 缓冲地址
var g_pool_gate: i64 = 0    // 池启动闸：首个 spawn 置 1（编译器据此建线程一次）
var g_pend_s: i64 = 0       // 未完成任务数（排队 + 运行中）

// ---------- 表全局惰性初始化（阶段1块2：trm_lite.a 静态链接时 main 不会初始化
// 库内表全局——@g = global ptr null，须在桥函数首次调用时创建；import 内联时
// main 已初始化，本函数幂等无害） ----------
var g_tl_sched_init: i64 = 0

func tl_sched_ensure() {
    if g_tl_sched_init == 0 {
        g_tq_entry = table_new_i64()
        g_tq_env = table_new_i64()
        g_tq_retcode = table_new_i64()
        g_tl_sched_init = 1
    }
}

namespace trm_lite_sched {

pub func set_workers(m: i64) {
    if m < 1 {
        return
    }
    g_worker = m
}
pub func workers() -> i64 {
    return g_worker
}

// ---------- 闭包任务队列（spawn/yield 内置运行时） ----------
// p.6.7.6：入队经 S-pool 线程安全路径（锁内 push + pend++ + 唤醒）。

// 惰性建 CS/CV 缓冲（幂等；tl_k32 纯声明源自持）。
func pool_sync_ensure() {
    if g_pool_ready == 0 {
        unsafe {
            g_cs_s = ptr_to_int(alloc(64))
            g_cv_s = ptr_to_int(alloc(64))
            InitializeCriticalSection(g_cs_s)
            InitializeConditionVariable(g_cv_s)
        }
        g_pool_ready = 1
    }
}
func p_lock() {
    pool_sync_ensure()
    unsafe {
        EnterCriticalSection(g_cs_s)
    }
}

// i64 → 指定地址逐字节写（x64 出参槽；对齐 tl_tbl w_i64 模式）。
unsafe fn wp_i64(p: i64, v: i64) {
    var k: i64 = 0
    while k < 8 {
        deref_write(int_to_ptr(p + k), (v >> (k * 8)) & 255)
        k = k + 1
    }
}
func p_unlock() {
    unsafe {
        LeaveCriticalSection(g_cs_s)
    }
}
func p_wake() {
    unsafe {
        WakeConditionVariable(g_cv_s)
    }
}
// 限时等待（条件变量；返回 0=超时/唤醒后须重查谓词）。
func p_wait(ms: i64) -> i64 {
    unsafe {
        return SleepConditionVariableCS(g_cv_s, g_cs_s, ms)
    }
}

// 入队一个轻量执行体（闭包入口/环境/返回形态）。锁内 push + pend++ + 唤醒。
// 返回任务 id。首个 spawn 前不起线程（线程由编译器发 CreateThread 建，池常驻）。
pub func spawn_task(entry: i64, env: i64, retcode: i64) -> i64 {
    tl_sched_ensure()
    p_lock()
    var id: i64 = len(g_tq_entry)
    table_push(g_tq_entry, entry)
    table_push(g_tq_env, env)
    table_push(g_tq_retcode, retcode)
    g_pend_s = g_pend_s + 1
    var ws = pool_workers()  // 广播唤醒全部常驻 worker（防轻任务被单 worker 独吞）
    var w: i64 = 0
    while w < ws {
        p_wake()
        w = w + 1
    }
    p_unlock()
    return id
}

// 池启动闸：首个调用置 1 并返回 1（编译器侧据此建常驻 worker 线程一次）；
// 后续调用返回 0（线程已在跑，直接复用）。
pub func pool_try_start() -> i64 {
    pool_sync_ensure()
    p_lock()
    var r: i64 = 0
    if g_pool_gate == 0 {
        g_pool_gate = 1
        r = 1
    }
    p_unlock()
    return r
}

// 池大小（编译器建线程数；set_workers 在首个 spawn 前设置生效）。
pub func pool_workers() -> i64 {
    if g_worker < 1 {
        return 4
    }
    return g_worker
}

// 未完成任务数（排队 + 运行中）。
pub func pend_count() -> i64 {
    pool_sync_ensure()
    p_lock()
    var p = g_pend_s
    p_unlock()
    return p
}

// 锁内原子摘队头任务：无任务返回 0；有则返回 entry 并把 env/rc 写入
// env_out/rc_out 槽（i64 地址；x64 ABI 逐字节写）。
pub func pop_task(env_out: i64, rc_out: i64) -> i64 {
    pool_sync_ensure()
    p_lock()
    if len(g_tq_entry) == 0 {
        p_unlock()
        return 0
    }
    var e0 = g_tq_entry[0]
    var v0 = g_tq_env[0]
    var r0 = g_tq_retcode[0]
    // 队头移除（无缩表原语：并行表重建）
    var ne = table_new_i64()
    var nv = table_new_i64()
    var nr = table_new_i64()
    var n = len(g_tq_entry)
    var i: i64 = 1
    while i < n {
        table_push(ne, g_tq_entry[i])
        table_push(nv, g_tq_env[i])
        table_push(nr, g_tq_retcode[i])
        i = i + 1
    }
    g_tq_entry = ne
    g_tq_env = nv
    g_tq_retcode = nr
    unsafe {
        wp_i64(env_out, v0)
        wp_i64(rc_out, r0)
    }
    p_unlock()
    return e0
}

// 任务完成（worker 执行后调用）：pend--，归零时广播（yield_wait 即时醒）。
pub func task_done() {
    pool_sync_ensure()
    p_lock()
    g_pend_s = g_pend_s - 1
    if g_pend_s == 0 {
        p_wake()
    }
    p_unlock()
}

// yield 新语义 = 同步点（p.6.7.6）：等全部已入队任务完成（pool 并行执行）。
// 与旧「单线程排空」观测等价（yield 返回时所有已 spawn 任务均已完成）。
pub func yield_wait() -> i64 {
    pool_sync_ensure()
    p_lock()
    while g_pend_s > 0 {
        p_wait(50)
    }
    p_unlock()
    return 0
}

// worker 空队限时等待（防忙轮询；被 spawn/task_done 唤醒或 2ms 超时——短超时
// 提高轻任务批的并行抢占概率）。
pub func pool_idle_wait() {
    pool_sync_ensure()
    p_lock()
    if len(g_tq_entry) == 0 && g_pend_s == 0 {
        p_wait(2)
    }
    p_unlock()
}

// 进程收尾：置停机标记 + 广播唤醒 + 常驻线程随进程退出回收（简单形态无 join 语义）。
pub func pool_shutdown() {
    pool_sync_ensure()
    p_lock()
    g_pool_gate = 0
    g_pend_s = 0
    p_unlock()
}
pub func queued_count() -> i64 {
    tl_sched_ensure()
    return len(g_tq_entry)
}
// 队头任务三要素（drain 分派用；空队列返回 0）。
pub func queued_entry() -> i64 {
    tl_sched_ensure()
    if len(g_tq_entry) == 0 {
        return 0
    }
    return g_tq_entry[0]
}
pub func queued_env() -> i64 {
    tl_sched_ensure()
    if len(g_tq_entry) == 0 {
        return 0
    }
    return g_tq_env[0]
}
pub func queued_retcode() -> i64 {
    tl_sched_ensure()
    if len(g_tq_entry) == 0 {
        return 0
    }
    return g_tq_retcode[0]
}
// 移除队头任务（无缩表原语：并行表重建）。
pub func queued_dequeue() {
    tl_sched_ensure()
    var ne = table_new_i64()
    var nv = table_new_i64()
    var nr = table_new_i64()
    var n = len(g_tq_entry)
    var i: i64 = 1
    while i < n {
        table_push(ne, g_tq_entry[i])
        table_push(nv, g_tq_env[i])
        table_push(nr, g_tq_retcode[i])
        i = i + 1
    }
    g_tq_entry = ne
    g_tq_env = nv
    g_tq_retcode = nr
}

pub func module_version() -> string {
    return TRM_LITE_SCHED_VERSION
}
}