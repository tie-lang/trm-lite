type tie<class>
// core/mnn/sched.tie —— trm-lite 阶段1：独立轻量执行体内核（协作式 M:N，命名空间 trm_lite_sched）。
// 对标 trm core/mnn 的探针语义，作为 trm-lite「简单执行体」的纯 tie 内核：
//   若干轻量执行体（each = step 上限的「体」）在固定 worker 池（M）上多路复用推进；
//   一个 tick 至多推进 M 个就绪执行体各一个 step（协作式 yield 的抽象，M:N 上界），
//   执行体跑满 total_step 即完成；run_all 循环 tick 直至全部完成。
// 状态用扁平 table<i64>（执行体 id 即下标），规避 tiec 嵌套表复绑定缺陷。
// 阶段1只做调度内核语义验证；「spawn 真正投递 tie 闭包」的薄内置接线在阶段1后续落地。

const TRM_LITE_SCHED_VERSION: string = "0.1.0"

// SchedResult：调度运行结果（busy_ticks = 有效调度周期，steps = 全部执行体推进总步进，
// peak_running = 峰值同时运行执行体数，始终 ≤ worker 池 M——即 M:N 上界）。
struct SchedResult {
    var busy_ticks: i64 = 0
    var steps: i64 = 0
    var peak_running: i64 = 0
}

// 执行体状态码
const S_READY: i64 = 0
const S_RUNNING: i64 = 1
const S_YIELD: i64 = 2
const S_DONE: i64 = 3

// ---------- 调度器状态（并行表，执行体 id 即下标） ----------
var g_worker: i64 = 2                 // worker 池大小 M
var g_id: table<i64>;                 // 逻辑执行体 id（顺序分配）
var g_state: table<i64>;              // 状态码
var g_step: table<i64>;               // 已推进步数
var g_total: table<i64>;              // 体总步数上限
var g_rq: table<i64>;                 // 就绪队列（执行体 id）
var g_run_peak: i64 = 0               // 观测峰值同时运行执行体数（≤ M）

// ---------- 闭包任务队列（阶段1块2：spawn/yield 内置的运行时载体） ----------
// 每个任务 = 一个「轻量执行体」：{entry, env, retcode}（entry/env 为闭包聚合的
// 入口/环境指针，i64 承载；retcode = 返回形态编码，0=i64 / 1=void）。
// 由 tiec 内置 codegen 以 extern 符号调用本组函数；tie 源码侧扁平表存储。
var g_tq_entry: table<i64>;           // 任务入口指针（entry）
var g_tq_env: table<i64>;             // 任务环境指针（env）
var g_tq_retcode: table<i64>;         // 任务返回形态编码

// 任务返回形态编码（与 tiec builtin_expr 的 drain 分派对齐）
const RET_I64: i64 = 0
const RET_VOID: i64 = 1

// ---------- 表全局惰性初始化（阶段1块2：trm_lite.a 静态链接时 main 不会初始化
// 库内表全局——@g = global ptr null，须在桥函数首次调用时创建；import 内联时
// main 已初始化，本函数幂等无害） ----------
var g_tl_sched_init: i64 = 0

func tl_sched_ensure() {
    if g_tl_sched_init == 0 {
        g_id = table_new_i64()
        g_state = table_new_i64()
        g_step = table_new_i64()
        g_total = table_new_i64()
        g_rq = table_new_i64()
        g_tq_entry = table_new_i64()
        g_tq_env = table_new_i64()
        g_tq_retcode = table_new_i64()
        g_tl_sched_init = 1
    }
}

namespace trm_lite_sched {

pub func set_workers(m: i64) {
    if m < 1 {
        return
    }
    g_worker = m
}
pub func workers() -> i64 {
    return g_worker
}

// 派生一个执行体（total_step = 体总步数上限）。返回执行体 id。
pub func spawn(total_step: i64) -> i64 {
    var cid: i64 = len(g_id)
    table_push(g_id, cid)
    table_push(g_state, S_READY)
    table_push(g_step, 0)
    table_push(g_total, total_step)
    table_push(g_rq, cid)
    return cid
}

pub func coro_state(id: i64) -> i64 {
    return g_state[id]
}
pub func coro_count() -> i64 {
    return len(g_id)
}
pub func coro_done_step(id: i64) -> i64 {
    return g_step[id]
}
pub func done_count() -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_state) {
        if g_state[i] == S_DONE {
            n = n + 1
        }
        i = i + 1
    }
    return n
}
pub func active_count() -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_state) {
        if g_state[i] != S_DONE {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// advance(id)：从就绪队列取一个执行体推进一个 step（协作式 yield 抽象）。
// 跑满 total_step → S_DONE；否则回到就绪队列。
func advance(id: i64) {
    g_state[id] = S_RUNNING
    g_step[id] = g_step[id] + 1
    if g_step[id] >= g_total[id] {
        g_state[id] = S_DONE
    } else {
        g_state[id] = S_READY
        table_push(g_rq, id)
    }
}

// tick()：本调度周期至多推进 M 个就绪执行体。返回推进数（0 = 无可推进）。
pub func tick() -> i64 {
    var n: i64 = 0
    var cnt: i64 = 0
    while n < g_worker && len(g_rq) > 0 {
        var id: i64 = g_rq[0]
        g_rq = remove_head(g_rq)
        advance(id)
        n = n + 1
        cnt = cnt + 1
    }
    if cnt > g_run_peak {
        g_run_peak = cnt
    }
    return cnt
}

// run_all()：持续 tick 直到全部完成。返回调度统计（busy_ticks 有效周期、steps 总步进、
// peak_running 峰值并发——M:N 上界探针）。
pub func run_all() -> SchedResult {
    var busy_ticks: i64 = 0
    var steps: i64 = 0
    var guard: i64 = 0
    while active_count() > 0 && guard < 100000 {
        var p = tick()
        busy_ticks = busy_ticks + 1
        steps = steps + p
        guard = guard + 1
    }
    return SchedResult(busy_ticks, steps, g_run_peak)
}

// ---------- 阶段1块2：闭包任务队列（spawn/yield 内置运行时） ----------
// spawn_task：入队一个轻量执行体（闭包入口/环境/返回形态）。返回任务 id。
pub func spawn_task(entry: i64, env: i64, retcode: i64) -> i64 {
    tl_sched_ensure()
    var id: i64 = len(g_tq_entry)
    table_push(g_tq_entry, entry)
    table_push(g_tq_env, env)
    table_push(g_tq_retcode, retcode)
    return id
}
pub func queued_count() -> i64 {
    tl_sched_ensure()
    return len(g_tq_entry)
}
// 队头任务三要素（drain 分派用；空队列返回 0）。
pub func queued_entry() -> i64 {
    tl_sched_ensure()
    if len(g_tq_entry) == 0 {
        return 0
    }
    return g_tq_entry[0]
}
pub func queued_env() -> i64 {
    tl_sched_ensure()
    if len(g_tq_entry) == 0 {
        return 0
    }
    return g_tq_env[0]
}
pub func queued_retcode() -> i64 {
    tl_sched_ensure()
    if len(g_tq_entry) == 0 {
        return 0
    }
    return g_tq_retcode[0]
}
// 移除队头任务（无缩表原语：并行表重建）。
pub func queued_dequeue() {
    tl_sched_ensure()
    var ne = table_new_i64()
    var nv = table_new_i64()
    var nr = table_new_i64()
    var n = len(g_tq_entry)
    var i: i64 = 1
    while i < n {
        table_push(ne, g_tq_entry[i])
        table_push(nv, g_tq_env[i])
        table_push(nr, g_tq_retcode[i])
        i = i + 1
    }
    g_tq_entry = ne
    g_tq_env = nv
    g_tq_retcode = nr
}

// 取就绪队列头并删除（无缩表原语：重建）。
func remove_head(q: table<i64>) -> table<i64> {
    var n = len(q)
    var nt = table_new_i64()
    var i: i64 = 1
    while i < n {
        table_push(nt, q[i])
        i = i + 1
    }
    return nt
}

pub func module_version() -> string {
    return TRM_LITE_SCHED_VERSION
}
}