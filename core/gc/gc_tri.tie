type tie<class>
// core/gc/gc_tri.tie —— trm-lite 复杂形态 GC（p.6.5.3 并发三色 / p.6.5.4 分代 + 整理）
// 托管堆模型（tie 可表达的扁平对象图，对象 id 即下标）：
//   对象表 g_o_size/g_o_alive/g_o_color/g_o_age（并行 table<i64>；age 分代）
//   边表   g_e_from/g_e_to/g_e_alive（from→to 引用，alive=生效）
//   根表   g_c_roots（保守根：显式 add_root；精确栈图 p.6.5.6 前任务 env 内引用
//          经写屏障维持不变量，sweep 仅无任务窗口执行）
//   记集   g_c_rs（remembered set：老年代→新生代 引用目标，minor 种子）
//   三色   0=白 1=灰 2=黑
// 分代（p.6.5.4）：
//   · 新生代 age<TG_AGE_T，老年代 age>=TG_AGE_T
//   · minor（半代）：重置 young 白 + 老黑；种子 = 全根 + rs；标记；sweep 只回收
//     young 白；存活 young age++（达阈值晋升）。老年代不被 young sweep。
//   · major：全量三色回收（同 p.6.5.3）+ **mark-compact**：存活对象按 id 升序
//     重排到表前段（old→new 重映射），重写边表/根表；回收槽压缩。
// 并发模型：独立 GC 锁 g_gc_cs；后台回收器（bg_step）做 minor + 与 worker 真并发；
// major 显式调用（ctx_gc_major / gc_collect_sync）。sweep 仅无任务窗口。
// 写屏障（Dijkstra 不变量）：set_ref 黑→白 置灰压栈；老→新 记 remembered set。
// 整理后对象 id 变化（remapped() 可查）；调用方以计数/新 id 使用。

import "../../core/mnn/tl_sync.tie"

const TG_WHITE: i64 = 0
const TG_GRAY: i64 = 1
const TG_BLACK: i64 = 2
const TG_AGE_T: i64 = 2    // 晋升阈值：存活 minor 轮 ≥2 → 老年代

var g_gc_cs: i64 = 0
var g_gc_init: i64 = 0

var g_o_size: table<i64> = []
var g_o_alive: table<i64> = []
var g_o_color: table<i64> = []
var g_o_age: table<i64> = []        // 0..T-1 新生代；≥T 老年代
var g_e_from: table<i64> = []
var g_e_to: table<i64> = []
var g_e_alive: table<i64> = []
var g_c_roots: table<i64> = []
var g_c_rs: table<i64> = []         // remembered set（老→新 目标）
var g_stack: table<i64> = []
var g_sp: i64 = 0
var g_remap: table<i64> = []        // 最近一次 major 整理的 old→new 映射（-1=已回收）

// 累计统计（跨轮，探针断言）
var g_steps_total: i64 = 0
var g_freed_total: i64 = 0     // major 累计回收
var g_minor_total: i64 = 0     // minor 累计回收（young）
var g_minor_runs: i64 = 0
var g_major_runs: i64 = 0
var g_compacted: i64 = 0       // 整理搬移存活对象数
var g_sweep_rounds: i64 = 0
var g_gc_cycle: i64 = 0

namespace trm_lite_tgc {

// 标记队列辅助（BFS 语义）：g_stack 只追加（tie 无尾部删除），g_sp = 队头游标；
// 空 = 游标越界。push 到尾部、peek/前进从队头取——每个元素恰好取一次，
// 避免「pop g_stack[g_sp-1] 与 append 尾部错位」造成的旧元素重复取。
func mark_reset() {
    g_stack = table_new_i64()
    g_sp = 0
}
func mark_push(x: i64) {
    table_push(g_stack, x)
}
func mark_peek() -> i64 {
    return g_stack[g_sp]
}
func mark_advance() {
    g_sp = g_sp + 1
}
func mark_empty() -> bool {
    return g_sp >= len(g_stack)
}

// 一次初始化（幂等）。
pub func ensure() {
    if g_gc_init == 0 {
        unsafe {
            g_gc_cs = ptr_to_int(alloc(64))
            tl_sync.cs_init(g_gc_cs)
        }
        g_o_size = table_new_i64()
        g_o_alive = table_new_i64()
        g_o_color = table_new_i64()
        g_o_age = table_new_i64()
        g_e_from = table_new_i64()
        g_e_to = table_new_i64()
        g_e_alive = table_new_i64()
        g_c_roots = table_new_i64()
        g_c_rs = table_new_i64()
        g_stack = table_new_i64()
        g_remap = table_new_i64()
        g_gc_init = 1
    }
}

pub func alloc(size: i64) -> i64 {
    ensure()
    var id: i64 = -1
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        id = len(g_o_size)
        table_push(g_o_size, size)
        table_push(g_o_alive, 1)
        table_push(g_o_color, TG_WHITE)
        table_push(g_o_age, 0)
        tl_sync.cs_leave(g_gc_cs)
    }
    return id
}

// 建立 from → to 的引用（第 k 条槽位：删旧、增新）+ 双写屏障：
//   1) Dijkstra：黑 → 白 置灰压栈（并发标记不漏标）
//   2) 记忆集：老年代(from) → 新生代(to) 记入 g_c_rs（minor 种子）
pub func set_ref(from: i64, k: i64, to: i64) {
    ensure()
    if from < 0 || from >= len(g_o_alive) {
        return
    }
    if to < 0 || to >= len(g_o_alive) {
        return
    }
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        if g_o_alive[from] != 1 || g_o_alive[to] != 1 {
            tl_sync.cs_leave(g_gc_cs)
            return
        }
        var seen: i64 = 0
        var e: i64 = 0
        while e < len(g_e_from) {
            if g_e_alive[e] == 1 && g_e_from[e] == from {
                if seen == k {
                    g_e_alive[e] = 0
                }
                seen = seen + 1
            }
            e = e + 1
        }
        table_push(g_e_from, from)
        table_push(g_e_to, to)
        table_push(g_e_alive, 1)
        // 屏障 1：黑 → 白
        if g_o_color[from] == TG_BLACK && g_o_color[to] == TG_WHITE {
            g_o_color[to] = TG_GRAY
            mark_push(to)
        }
        // 屏障 2：老 → 新 记忆集（去重遍历，容忍表增长）
        if g_o_age[from] >= TG_AGE_T && g_o_age[to] < TG_AGE_T && g_o_alive[to] == 1 {
            var dup: i64 = 0
            var ri: i64 = 0
            while ri < len(g_c_rs) {
                if g_c_rs[ri] == to {
                    dup = 1
                }
                ri = ri + 1
            }
            if dup == 0 {
                table_push(g_c_rs, to)
            }
        }
        tl_sync.cs_leave(g_gc_cs)
    }
}

// 移除 from 的第 k 条活跃出边（删边无需屏障）。
pub func drop_ref(from: i64, k: i64) {
    ensure()
    if from < 0 || from >= len(g_o_alive) {
        return
    }
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        if g_o_alive[from] != 1 {
            tl_sync.cs_leave(g_gc_cs)
            return
        }
        var seen: i64 = 0
        var e: i64 = 0
        while e < len(g_e_from) {
            if g_e_alive[e] == 1 && g_e_from[e] == from {
                if seen == k {
                    g_e_alive[e] = 0
                }
                seen = seen + 1
            }
            e = e + 1
        }
        tl_sync.cs_leave(g_gc_cs)
    }
}

// 登记回收根（保守根；去重）。cycle 进行中与新根 → 置灰压栈（根写屏障，
// p.6.5.3：防晚到根 white 被 young sweep 误收）。
pub func add_root(id: i64) {
    ensure()
    if id < 0 || id >= len(g_o_alive) {
        return
    }
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        var i: i64 = 0
        var dup = 0
        while i < len(g_c_roots) {
            if g_c_roots[i] == id {
                dup = 1
            }
            i = i + 1
        }
        if dup == 0 {
            table_push(g_c_roots, id)
        }
        if g_gc_cycle == 1 && g_o_alive[id] == 1 {
            g_o_color[id] = TG_GRAY
            mark_push(id)
        }
        tl_sync.cs_leave(g_gc_cs)
    }
}

pub func drop_root(id: i64) {
    ensure()
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        var nt = table_new_i64()
        var j: i64 = 0
        while j < len(g_c_roots) {
            if g_c_roots[j] != id {
                table_push(nt, g_c_roots[j])
            }
            j = j + 1
        }
        g_c_roots = nt
        tl_sync.cs_leave(g_gc_cs)
    }
}

// ---------- 观察量 ----------
pub func obj_alive(id: i64) -> bool {
    if id < 0 || id >= len(g_o_alive) {
        return false
    }
    return g_o_alive[id] == 1
}
pub func obj_color(id: i64) -> i64 {
    if id < 0 || id >= len(g_o_color) {
        return -1
    }
    return g_o_color[id]
}
pub func obj_age(id: i64) -> i64 {
    if id < 0 || id >= len(g_o_age) {
        return -1
    }
    return g_o_age[id]
}
// 最近一次 major 整理的 old→new 映射（-1 = 已回收 / 未登记）
pub func remapped(old: i64) -> i64 {
    if old < 0 || old >= len(g_remap) {
        return -1
    }
    return g_remap[old]
}
pub func live_count() -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_o_alive) {
        if g_o_alive[i] == 1 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}
pub func alloc_count() -> i64 {
    return len(g_o_size)
}
// 全部登记根中，compact 重映射后仍存活的数量（sync collect 后 = 全存活）。
pub func root_survivors() -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_c_roots) {
        var rid = g_c_roots[i]
        if rid >= 0 && rid < len(g_o_alive) && g_o_alive[rid] == 1 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}
pub func ref_count(of: i64) -> i64 {
    var n: i64 = 0
    var e: i64 = 0
    while e < len(g_e_from) {
        if g_e_alive[e] == 1 && g_e_from[e] == of {
            n = n + 1
        }
        e = e + 1
    }
    return n
}
pub func ref_to(of: i64, k: i64) -> i64 {
    var n: i64 = 0
    var e: i64 = 0
    while e < len(g_e_from) {
        if g_e_alive[e] == 1 && g_e_from[e] == of {
            if n == k {
                return g_e_to[e]
            }
            n = n + 1
        }
        e = e + 1
    }
    return -1
}
pub func steps_total() -> i64 {
    return g_steps_total
}
pub func freed_total() -> i64 {
    return g_freed_total
}
pub func minor_freed_total() -> i64 {
    return g_minor_total
}
pub func minor_runs() -> i64 {
    return g_minor_runs
}
pub func major_runs() -> i64 {
    return g_major_runs
}
pub func compacted_total() -> i64 {
    return g_compacted
}
pub func sweep_rounds() -> i64 {
    return g_sweep_rounds
}
pub func mark_done_view() -> i64 {
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        var done: i64 = 0
        if mark_empty() {
            done = 1
        }
        tl_sync.cs_leave(g_gc_cs)
        return done
    }
}

// ---------- 标记内核（调用方须已持锁） ----------
// 标记栈：g_stack 为 table（append 语义，历史元素不删除），g_sp = 栈尾索引
// （空栈 = -1）。push 后索引 = len-1；pop 读 g_stack[g_sp] 并递减。
// （曾用 g_sp 做元素计数 + g_stack[g_sp-1] pop：table append 后新旧元素错位，
//   重复 pop 到旧根，多级对象停留 gray 不标黑——p.6.5.3 直连形态误通过。）
func step_locked() -> i64 {
    if mark_empty() {
        return 0
    }
    var cur = mark_peek()
    mark_advance()
    g_o_color[cur] = TG_BLACK
    var e: i64 = 0
    while e < len(g_e_from) {
        if g_e_alive[e] == 1 && g_e_from[e] == cur {
            var tgt = g_e_to[e]
            if tgt >= 0 && tgt < len(g_o_alive) && g_o_alive[tgt] == 1 && g_o_color[tgt] == TG_WHITE {
                g_o_color[tgt] = TG_GRAY
                mark_push(tgt)
            }
        }
        e = e + 1
    }
    return 1
}

// 半代（minor）起始：young 全白 + 老年代置黑；种子 = 全部根 + 记忆集。
// 调用方已持锁。
func minor_begin_locked() {
    var i: i64 = 0
    while i < len(g_o_color) {
        if g_o_alive[i] == 1 {
            if g_o_age[i] < TG_AGE_T {
                g_o_color[i] = TG_WHITE
            } else {
                g_o_color[i] = TG_BLACK  // 老年代视为已标
            }
        }
        i = i + 1
    }
    mark_reset()
    i = 0
    while i < len(g_c_roots) {
        var rid = g_c_roots[i]
        if rid >= 0 && rid < len(g_o_alive) && g_o_alive[rid] == 1 {
            g_o_color[rid] = TG_GRAY
            mark_push(rid)
        }
        i = i + 1
    }
    i = 0
    while i < len(g_c_rs) {
        var sid = g_c_rs[i]
        if sid >= 0 && sid < len(g_o_alive) && g_o_alive[sid] == 1 && g_o_color[sid] == TG_WHITE {
            g_o_color[sid] = TG_GRAY
            mark_push(sid)
        }
        i = i + 1
    }
}

// minor sweep：回收 young 白；存活 young age++（达阈值晋升老年代）。调用方持锁。
// 晋升屏障：刚晋升对象的历史老→新 出边此刻才成立（写时 from 尚 young，未入 rs），
// 补记 remembered set，保证下轮 minor 的 rs 种子覆盖新老→新 引用。
func minor_sweep_locked() -> i64 {
    var freed: i64 = 0
    var i: i64 = 0
    while i < len(g_o_alive) {
        if g_o_alive[i] == 1 && g_o_age[i] < TG_AGE_T {
            if g_o_color[i] == TG_WHITE {
                g_o_alive[i] = 0
                freed = freed + 1
            } else {
                g_o_age[i] = g_o_age[i] + 1   // 存活 young 晋升计数
            }
        }
        i = i + 1
    }
    // 晋升屏障：全部 edges 里 存活 老→新 出边补进 rs（覆盖晋升历史边；幂等去重）
    var e: i64 = 0
    while e < len(g_e_from) {
        var f = g_e_from[e]
        var t = g_e_to[e]
        if g_e_alive[e] == 1 && f >= 0 && f < len(g_o_alive) && t >= 0 && t < len(g_o_alive) {
            if g_o_alive[f] == 1 && g_o_alive[t] == 1 && g_o_age[f] >= TG_AGE_T && g_o_age[t] < TG_AGE_T {
                var dup: i64 = 0
                var ri: i64 = 0
                while ri < len(g_c_rs) {
                    if g_c_rs[ri] == t {
                        dup = 1
                    }
                    ri = ri + 1
                }
                if dup == 0 {
                    table_push(g_c_rs, t)
                }
            }
        }
        e = e + 1
    }
    g_minor_runs = g_minor_runs + 1
    return freed
}

// 同步 minor 收集（无并发窗口用）。返回本轮 young freed。
// rs 持久累积不清空：撤离「两轮之间写屏障记录的旧→新 条目」被清空抹掉；
// 陈旧条目由种子时 alive/WHITE 守卫过滤，保持正确性。
pub func gc_minor_sync() -> i64 {
    ensure()
    var freed: i64 = -1
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        minor_begin_locked()
        while !mark_empty() {
            step_locked()
        }
        freed = minor_sweep_locked()
        g_minor_total = g_minor_total + freed
        g_sweep_rounds = g_sweep_rounds + 1
        tl_sync.cs_leave(g_gc_cs)
    }
    return freed
}

// mark-compact：重排存活对象到前段，old→new 映射，重写边/根。调用方持锁。
// 前提：color 已标记（黑=存活）。返回整理搬移存活数。
func compact_locked() -> i64 {
    var n = len(g_o_size)
    // 1) old→new 映射（存活黑对象按 id 升序）
    var newid: i64 = 0
    var i: i64 = 0
    var rm: table<i64> = table_new_i64()
    while i < n {
        if g_o_alive[i] == 1 && g_o_color[i] == TG_BLACK {
            table_push(rm, newid)
            newid = newid + 1
        } else {
            table_push(rm, -1)
        }
        i = i + 1
    }
    // 2) 重排对象表（size/alive/color/age）
    var ns: table<i64> = table_new_i64()
    var na: table<i64> = table_new_i64()
    var nc: table<i64> = table_new_i64()
    var ng: table<i64> = table_new_i64()
    i = 0
    while i < n {
        var r = rm[i]
        if r >= 0 {
            table_push(ns, g_o_size[i])
            table_push(na, 1)
            table_push(nc, TG_BLACK)
            table_push(ng, g_o_age[i])
        }
        i = i + 1
    }
    // 3) 边压缩重写
    var nfrom: table<i64> = table_new_i64()
    var nto: table<i64> = table_new_i64()
    var nalive: table<i64> = table_new_i64()
    var e: i64 = 0
    while e < len(g_e_from) {
        if g_e_alive[e] == 1 {
            var f = rm[g_e_from[e]]
            var t = rm[g_e_to[e]]
            if f >= 0 && t >= 0 {
                table_push(nfrom, f)
                table_push(nto, t)
                table_push(nalive, 1)
            }
        }
        e = e + 1
    }
    // 4) 根重写
    var nr: table<i64> = table_new_i64()
    var ri: i64 = 0
    while ri < len(g_c_roots) {
        var rr = rm[g_c_roots[ri]]
        if rr >= 0 {
            table_push(nr, rr)
        }
        ri = ri + 1
    }
    // 5) 生效 + 记录
    g_remap = rm
    g_o_size = ns
    g_o_alive = na
    g_o_color = nc
    g_o_age = ng
    g_e_from = nfrom
    g_e_to = nto
    g_e_alive = nalive
    g_c_roots = nr
    var nt2 = table_new_i64()
    g_c_rs = nt2
    mark_reset()
    g_compacted = g_compacted + newid
    return newid
}

// 同步 major 收集（全量三色 + mark-compact 整理）。返回本轮 freed。
// 组织后对象 id 变化：remapped(old) 查询映射；调用方按新 id 使用。
pub func gc_collect_sync() -> i64 {
    ensure()
    var freed: i64 = -1
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        var i: i64 = 0
        while i < len(g_o_color) {
            g_o_color[i] = TG_WHITE
            i = i + 1
        }
        mark_reset()
        i = 0
        while i < len(g_c_roots) {
            var rid = g_c_roots[i]
            if rid >= 0 && rid < len(g_o_alive) && g_o_alive[rid] == 1 {
                g_o_color[rid] = TG_GRAY
                mark_push(rid)
            }
            i = i + 1
        }
        while !mark_empty() {
            step_locked()
        }
        freed = 0
        i = 0
        while i < len(g_o_alive) {
            if g_o_alive[i] == 1 && g_o_color[i] == TG_WHITE {
                g_o_alive[i] = 0
                freed = freed + 1
            }
            i = i + 1
        }
        g_freed_total = g_freed_total + freed
        g_major_runs = g_major_runs + 1
        g_sweep_rounds = g_sweep_rounds + 1
        // mark-compact：重排存活到前段
        compact_locked()
        tl_sync.cs_leave(g_gc_cs)
    }
    return freed
}

// 后台轮次状态机（供 sched_ws 回收器线程反复调用）：做 **minor**（young 回收），
// 与 worker 真并发推进标记；sweep 仅无任务窗口。major 由调用方显式触发。
// 返回 1 当本轮 minor sweep 已完成；否则 0。
pub func bg_step(batch: i64, idle: i64) -> i64 {
    ensure()
    var finished: i64 = 0
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        if g_gc_cycle != 1 {
            // rs 持久累积（不清空）：两轮之间的写屏障条目保留；陈旧由种子守卫过滤
            minor_begin_locked()
            g_gc_cycle = 1
        }
        var i: i64 = 0
        while i < batch && !mark_empty() {
            step_locked()
            i = i + 1
        }
        g_steps_total = g_steps_total + i
        if mark_empty() && idle == 1 && g_gc_cycle == 1 {
            var freed = minor_sweep_locked()
            g_minor_total = g_minor_total + freed
            g_sweep_rounds = g_sweep_rounds + 1
            g_gc_cycle = 2
            finished = 1
        }
        tl_sync.cs_leave(g_gc_cs)
    }
    return finished
}

// 运行时清理（进程收尾）。
pub func shutdown() {
    if g_gc_init == 1 {
        unsafe {
            tl_sync.cs_del(g_gc_cs)
        }
        g_gc_init = 0
    }
}
}