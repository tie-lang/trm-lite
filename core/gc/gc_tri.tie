type tie<class>
// core/gc/gc_tri.tie —— trm-lite 复杂形态并发三色 GC（p.6.5.3）
// 托管堆模型（tie 可表达的扁平对象图，对象 id 即下标）：
//   对象表 g_o_size/g_o_alive/g_o_color（并行 table<i64>）
//   边表   g_e_from/g_e_to/g_e_alive（from→to 引用，alive=生效）
//   根表   g_c_roots（**保守根**；g_c_ 前缀规避旧 trm_lite.a 内同名全局的链接期冲突：显式 add_root 登记；语言精确栈图
//          尚未落地（p.6.5.6）前，任务栈/env 内引用经写屏障维持不变量，
//          sweep 仅发生在无任务运行窗口 ⇒ 保守根 + 不变量即正确集）
// 三色：0=白（未标记）1=灰（标记栈中）2=黑（已扫）
// 并发模型（与 trm_lite_ws 的 worker 真并行）：
//   独立 GC 锁 g_gc_cs 保护本模块全部状态；写屏障与标记推进互斥；
//   调度侧保证 sweep 只在「无任务运行」（pending==0&&active==0）后发生，
//   此窗口无写屏障 ⇒ sweep 无并发写。标记/写屏障无锁交叉（GC 线程绝不
//   嵌套持有调度锁 g_cs）。
// 写屏障（Dijkstra 不变量「黑不指向白」）：set_ref 写入黑→白 引用时，
//   目标置灰压栈——并发标记不漏标。
// 分代/整理（p.6.5.4）/ 精确栈图（p.6.5.6）后置。

import "../../core/mnn/tl_sync.tie"

const TG_WHITE: i64 = 0
const TG_GRAY: i64 = 1
const TG_BLACK: i64 = 2

var g_gc_cs: i64 = 0          // GC 锁（CRITICAL_SECTION 缓冲地址）
var g_gc_init: i64 = 0

var g_o_size: table<i64>      // 对象字节大小
var g_o_alive: table<i64>     // 0/1 槽位占用
var g_o_color: table<i64>     // 三色
var g_e_from: table<i64>
var g_e_to: table<i64>
var g_e_alive: table<i64>
var g_c_roots: table<i64>
var g_stack: table<i64>       // 灰度标记栈
var g_sp: i64 = 0             // 栈顶游标

// 累计统计（跨轮，探针断言）
var g_steps_total: i64 = 0    // 标记推进步数
var g_freed_total: i64 = 0    // 已回收对象总数
var g_sweep_rounds: i64 = 0   // 已完成回收轮数
var g_gc_cycle: i64 = 0       // 后台轮次状态：0=未开始 1=标记中 2=已 sweep

namespace trm_lite_tgc {

// 一次初始化（幂等）。
pub func ensure() {
    if g_gc_init == 0 {
        unsafe {
            g_gc_cs = ptr_to_int(alloc(64))
            tl_sync.cs_init(g_gc_cs)
        }
        g_o_size = table_new_i64()
        g_o_alive = table_new_i64()
        g_o_color = table_new_i64()
        g_e_from = table_new_i64()
        g_e_to = table_new_i64()
        g_e_alive = table_new_i64()
        g_c_roots = table_new_i64()
        g_stack = table_new_i64()
        g_gc_init = 1
    }
}

// 分配登记：返回对象 id（size 记录；真实字节堆 p.6.5.4 整理后接）。
pub func alloc(size: i64) -> i64 {
    ensure()
    var id: i64 = -1
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        id = len(g_o_size)
        table_push(g_o_size, size)
        table_push(g_o_alive, 1)
        table_push(g_o_color, TG_WHITE)
        tl_sync.cs_leave(g_gc_cs)
    }
    return id
}

// 建立 from → to 的引用（第 k 条槽位：删旧、增新）+ 写屏障。
// k 为 from 发出的引用槽序号（0..ref_count-1）。
// 写屏障：若 from 黑 且 to 白（且 to 存活）→ to 置灰压栈（黑不指向白）。
pub func set_ref(from: i64, k: i64, to: i64) {
    ensure()
    if from < 0 || from >= len(g_o_alive) {
        return
    }
    if to < 0 || to >= len(g_o_alive) {
        return
    }
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        if g_o_alive[from] != 1 || g_o_alive[to] != 1 {
            tl_sync.cs_leave(g_gc_cs)
            return
        }
        // 删 from 第 k 条活跃出边（无缩表：alive 置 0）
        var seen: i64 = 0
        var e: i64 = 0
        while e < len(g_e_from) {
            if g_e_alive[e] == 1 && g_e_from[e] == from {
                if seen == k {
                    g_e_alive[e] = 0
                }
                seen = seen + 1
            }
            e = e + 1
        }
        // 追加新边
        table_push(g_e_from, from)
        table_push(g_e_to, to)
        table_push(g_e_alive, 1)
        // 写屏障：黑 → 白 校正
        if g_o_color[from] == TG_BLACK && g_o_color[to] == TG_WHITE {
            g_o_color[to] = TG_GRAY
            table_push(g_stack, to)
            g_sp = g_sp + 1
        }
        tl_sync.cs_leave(g_gc_cs)
    }
}

// 移除 from 的第 k 条活跃出边（删边无需屏障——不产生黑→白）。
pub func drop_ref(from: i64, k: i64) {
    ensure()
    if from < 0 || from >= len(g_o_alive) {
        return
    }
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        if g_o_alive[from] != 1 {
            tl_sync.cs_leave(g_gc_cs)
            return
        }
        var seen: i64 = 0
        var e: i64 = 0
        while e < len(g_e_from) {
            if g_e_alive[e] == 1 && g_e_from[e] == from {
                if seen == k {
                    g_e_alive[e] = 0
                }
                seen = seen + 1
            }
            e = e + 1
        }
        tl_sync.cs_leave(g_gc_cs)
    }
}

// 登记回收根（保守根；去重）。
// p.6.5.3 修正：后台 cycle 进行中（g_gc_cycle==1）新登记的根必须**置灰压栈**——
// 否则（cycle 首个 begin 早于任务登记根时）晚到的根保持白色，收敛 sweep 会误回收。
// 语义 = 与 set_ref 写屏障同族的「根写屏障」。
pub func add_root(id: i64) {
    ensure()
    if id < 0 || id >= len(g_o_alive) {
        return
    }
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        var i: i64 = 0
        var dup = 0
        while i < len(g_c_roots) {
            if g_c_roots[i] == id {
                dup = 1
            }
            i = i + 1
        }
        if dup == 0 {
            table_push(g_c_roots, id)
        }
        if g_gc_cycle == 1 && g_o_alive[id] == 1 {
            g_o_color[id] = TG_GRAY
            table_push(g_stack, id)
            g_sp = g_sp + 1
        }
        tl_sync.cs_leave(g_gc_cs)
    }
}

pub func drop_root(id: i64) {
    ensure()
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        var nt = table_new_i64()
        var j: i64 = 0
        while j < len(g_c_roots) {
            if g_c_roots[j] != id {
                table_push(nt, g_c_roots[j])
            }
            j = j + 1
        }
        g_c_roots = nt
        tl_sync.cs_leave(g_gc_cs)
    }
}

// ---------- 观察量（探针断言） ----------
pub func obj_alive(id: i64) -> bool {
    if id < 0 || id >= len(g_o_alive) {
        return false
    }
    return g_o_alive[id] == 1
}
pub func obj_color(id: i64) -> i64 {
    if id < 0 || id >= len(g_o_color) {
        return -1
    }
    return g_o_color[id]
}
pub func live_count() -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < len(g_o_alive) {
        if g_o_alive[i] == 1 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}
pub func alloc_count() -> i64 {
    return len(g_o_size)
}
pub func ref_count(of: i64) -> i64 {
    var n: i64 = 0
    var e: i64 = 0
    while e < len(g_e_from) {
        if g_e_alive[e] == 1 && g_e_from[e] == of {
            n = n + 1
        }
        e = e + 1
    }
    return n
}
pub func ref_to(of: i64, k: i64) -> i64 {
    var n: i64 = 0
    var e: i64 = 0
    while e < len(g_e_from) {
        if g_e_alive[e] == 1 && g_e_from[e] == of {
            if n == k {
                return g_e_to[e]
            }
            n = n + 1
        }
        e = e + 1
    }
    return -1
}
pub func steps_total() -> i64 {
    return g_steps_total
}
pub func freed_total() -> i64 {
    return g_freed_total
}
pub func sweep_rounds() -> i64 {
    return g_sweep_rounds
}
pub func mark_done_view() -> i64 {
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        var done: i64 = 0
        if g_sp == 0 {
            done = 1
        }
        tl_sync.cs_leave(g_gc_cs)
        return done
    }
}

// ---------- 标记内核（调用方须已持锁，或经批处理包装） ----------
// 标记一步：弹灰 → 自身变黑 → 扫出边把白目标置灰压栈。
// 返回：本次推进标记的对象数。
func step_locked() -> i64 {
    if g_sp <= 0 {
        return 0
    }
    var cur = g_stack[g_sp - 1]
    g_sp = g_sp - 1
    g_o_color[cur] = TG_BLACK
    var e: i64 = 0
    while e < len(g_e_from) {
        if g_e_alive[e] == 1 && g_e_from[e] == cur {
            var tgt = g_e_to[e]
            if tgt >= 0 && tgt < len(g_o_alive) && g_o_alive[tgt] == 1 && g_o_color[tgt] == TG_WHITE {
                g_o_color[tgt] = TG_GRAY
                table_push(g_stack, tgt)
                g_sp = g_sp + 1
            }
        }
        e = e + 1
    }
    return 1
}

// 批处理标记：至多推进 n 步（或灰栈空）。返回实际推进数。
// 供后台回收器线程与 worker（写屏障）真并发执行；持锁 ≤ 批时长。
pub func run_batch(n: i64) -> i64 {
    ensure()
    var d: i64 = 0
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        var i: i64 = 0
        while i < n && g_sp > 0 {
            var s = step_locked()
            d = d + s
            i = i + 1
        }
        g_steps_total = g_steps_total + d
        tl_sync.cs_leave(g_gc_cs)
    }
    return d
}

// 同步完整收集（无并发窗口用）：置根灰 → 标到收敛 → 回收白。
// 返回本轮 freed。颜色全重置为白起始。
pub func gc_collect_sync() -> i64 {
    ensure()
    var freed: i64 = -1
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        var i: i64 = 0
        while i < len(g_o_color) {
            g_o_color[i] = TG_WHITE
            i = i + 1
        }
        g_sp = 0
        i = 0
        while i < len(g_c_roots) {
            var rid = g_c_roots[i]
            if rid >= 0 && rid < len(g_o_alive) && g_o_alive[rid] == 1 {
                g_o_color[rid] = TG_GRAY
                table_push(g_stack, rid)
                g_sp = g_sp + 1
            }
            i = i + 1
        }
        while g_sp > 0 {
            step_locked()
        }
        freed = 0
        i = 0
        while i < len(g_o_alive) {
            if g_o_alive[i] == 1 && g_o_color[i] == TG_WHITE {
                g_o_alive[i] = 0
                freed = freed + 1
            }
            i = i + 1
        }
        g_freed_total = g_freed_total + freed
        g_sweep_rounds = g_sweep_rounds + 1
        tl_sync.cs_leave(g_gc_cs)
    }
    return freed
}

// 后台轮次状态机（供 sched_ws 回收器线程反复调用）：
//   1. 轮次未开始（cyc!=1）→ 重置全白 + 根置灰压栈（新轮起始）
//   2. 推进至多 batch 步标记（与 worker 写屏障并发）
//   3. idle（无任务窗口）且灰栈空 → sweep 白对象 → 全白重置 → cyc=2
// 返回 1 当本轮 sweep 已完成（调用方可据 idle 决定退出）；否则 0。
// 正确性：sweep 仅发生在 idle（pending==0 && active==0，无写屏障窗口）；
// 写屏障（黑→白 置灰）保证不变量「黑不指向白」，并发标记不漏标。
pub func bg_step(batch: i64, idle: i64) -> i64 {
    ensure()
    var finished: i64 = 0
    unsafe {
        tl_sync.cs_enter(g_gc_cs)
        // 轮次起始（首调或 sweep 后重开）
        if g_gc_cycle != 1 {
            var i: i64 = 0
            while i < len(g_o_color) {
                g_o_color[i] = TG_WHITE
                i = i + 1
            }
            g_sp = 0
            var ri: i64 = 0
            while ri < len(g_c_roots) {
                var rid = g_c_roots[ri]
                if rid >= 0 && rid < len(g_o_alive) && g_o_alive[rid] == 1 {
                    g_o_color[rid] = TG_GRAY
                    table_push(g_stack, rid)
                    g_sp = g_sp + 1
                }
                ri = ri + 1
            }
            g_gc_cycle = 1
        }
        // 标记推进
        var i: i64 = 0
        while i < batch && g_sp > 0 {
            step_locked()
            i = i + 1
        }
        g_steps_total = g_steps_total + i
        // 收敛 + sweep（仅 idle 窗口）
        if g_sp == 0 && idle == 1 && g_gc_cycle == 1 {
            var freed: i64 = 0
            var j: i64 = 0
            while j < len(g_o_alive) {
                if g_o_alive[j] == 1 && g_o_color[j] == TG_WHITE {
                    g_o_alive[j] = 0
                    freed = freed + 1
                }
                j = j + 1
            }
            g_freed_total = g_freed_total + freed
            g_sweep_rounds = g_sweep_rounds + 1
            // 全白重置，下一轮起始
            var k: i64 = 0
            while k < len(g_o_color) {
                g_o_color[k] = TG_WHITE
                k = k + 1
            }
            g_sp = 0
            g_gc_cycle = 2
            finished = 1
        }
        tl_sync.cs_leave(g_gc_cs)
    }
    return finished
}

// 运行时清理（进程收尾）。
pub func shutdown() {
    if g_gc_init == 1 {
        unsafe {
            tl_sync.cs_del(g_gc_cs)
        }
        g_gc_init = 0
    }
}
}