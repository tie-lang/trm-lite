type tie<logic>
// tests/s10_exec/exec_demo.tie —— trm-lite 阶段1验收：独立轻量执行体内核 + 简单 mark-sweep GC。
// 场景A（调度）：M=2 worker 上 spawn 5 执行体 × 3 step，run_all 断言全程 done=5、步进=15、
//   peak_running≤2（M:N 上界）。
// 场景B（GC）：alloc 4 对象成图（0→1→2，3 独立），建根 0 后 gc：断 3 件 freed（1/2/3 不可达）、
//   0 live 且 total=4（累计）、root_count=1。
// 场景C（联动）：调度核里的执行体各自分配对象，收集后可回收——两内核正交可叠加。
// 出口：两场景均通过打印「阶段1执行内核验收通过」。

import "../../core/mnn/sched.tie"
import "../../core/gc/gc.tie"

func main() {
    println("== trm-lite 阶段1：执行体内核 + 简单 GC ==")

    // ---------- 场景A：M:N 调度 ----------
    trm_lite_sched.set_workers(2)
    var i: i64 = 0
    while i < 5 {
        trm_lite_sched.spawn(3)   // 5 执行体 × 3 step
        i = i + 1
    }
    var r = trm_lite_sched.run_all()
    println("[sched] done=" + to_string(trm_lite_sched.done_count())
        + "  steps=" + to_string(r.steps)
        + "  busy=" + to_string(r.busy_ticks)
        + "  peak=" + to_string(r.peak_running))
    var sched_ok = false
    if trm_lite_sched.done_count() == 5 && r.steps == 15 && r.peak_running <= 2 {
        sched_ok = true
    }

    // ---------- 场景B：简单 mark-sweep GC ----------
    var o0 = trm_lite_gc.alloc(16)
    var o1 = trm_lite_gc.alloc(32)
    var o2 = trm_lite_gc.alloc(64)
    var o3 = trm_lite_gc.alloc(8)
    trm_lite_gc.add_edge(o0, o1)
    trm_lite_gc.add_edge(o1, o2)
    // 根仅 0：链 0→1→2 可达，独立 o3 无入边 → 本轮只回收 o3。
    trm_lite_gc.add_root(o0)
    var g = trm_lite_gc.gc()
    var gc_ok = false
    if g.freed == 1 && trm_lite_gc.live_count() == 3 && g.total == 4 && trm_lite_gc.root_count() == 1 {
        gc_ok = true
    }
    println("[gc] total=" + to_string(g.total)
        + "  live=" + to_string(g.live)
        + "  freed=" + to_string(g.freed))

    if !sched_ok || !gc_ok {
        println("阶段1执行内核验收失败")
        return
    }
    println("阶段1执行内核验收通过")
}