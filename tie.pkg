// 与 trm（路线 B 字节码 VM）并行开发、互不干扰。

[
    "name": "trm-lite",
    "version": "0.1.0",
    "description": "tie 平台的 Go 式静态内置运行时",
    "role": "logic",
    "main": "main.tie",
    "author": "houyangbaoxin2009",
